# ============================================
# FACEBOOK MARKETPLACE MANAGER - CONFIGURATION
# ============================================

# --------- DATABASE ---------
DATABASE_URL=sqlite:///./facebook_marketplace.db
# For PostgreSQL: postgresql://user:password@localhost:5432/facebook_marketplace

# --------- FACEBOOK CREDENTIALS ---------
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password
FACEBOOK_2FA_BACKUP_CODE=your_2fa_backup_code

# --------- AI VISION PROVIDERS ---------
# Choose one: "openai" or "anthropic"
VISION_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# --------- LLM PROVIDERS ---------
# Choose one: "openai" or "anthropic"
LLM_PROVIDER=openai

# --------- MARKETPLACE SCRAPING ---------
MARKETPLACE_SEARCH_INTERVAL_MINUTES=15
COMPARABLE_LISTINGS_COUNT=18
IMAGE_COMPRESSION_QUALITY=85
IMAGE_MAX_WIDTH=1200

# --------- OFFER SETTINGS ---------
OFFER_AGGRESSIVENESS_MULTIPLIER=1.0
OFFER_MIN_FLOOR_PERCENTAGE=40
OFFER_ABSOLUTE_MINIMUM_DOLLARS=5
CONDITION_THRESHOLD_PERCENTAGE=50
LISTING_AGE_MOTIVATED_DAYS=14

# --------- MESSENGER AUTOMATION ---------
MESSENGER_DAILY_CAP=20
MESSENGER_DELAY_MIN_SECONDS=30
MESSENGER_DELAY_MAX_SECONDS=180
HUMAN_REVIEW_QUEUE_ENABLED=true
AUTO_SEND_ENABLED=false

# --------- MESSAGE GENERATION ---------
MESSAGE_TONE=casual
MESSAGE_MENTION_COMPS=true
MESSAGE_MENTION_CONDITION=true

# --------- SCHEDULER ---------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/New_York

# --------- LOGGING ---------
LOG_LEVEL=INFO
LOG_FILE=logs/facebook_marketplace.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --------- WEB APP ---------
FAST_API_HOST=0.0.0.0
FAST_API_PORT=8000
FAST_API_RELOAD=true
